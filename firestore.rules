rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Roof Inspection & Tile Installation Daily Reports
    match /roof_reports/{reportId} {
      allow read: if true;
      allow create, update: if isValidId(reportId)
        && request.resource.data.id is string
        && request.resource.data.dataPreenchimento is string;
      allow delete: if isValidId(reportId);
    }

    // Operational Calendar Tasks & Site Events
    match /calendar_tasks/{taskId} {
      allow read: if true;
      allow create, update: if isValidId(taskId)
        && request.resource.data.id is string
        && request.resource.data.title is string
        && request.resource.data.date is string;
      allow delete: if isValidId(taskId);
    }

    // Weather Alerts & Gemini AI Intempérie Analysis
    match /weather_alerts/{alertId} {
      allow read: if true;
      allow create, update: if isValidId(alertId)
        && request.resource.data.id is string;
      allow delete: if isValidId(alertId);
    }

    // AI Actions & Contingency Approvals
    match /ai_actions/{actionId} {
      allow read: if true;
      allow create, update: if isValidId(actionId)
        && request.resource.data.id is string;
      allow delete: if isValidId(actionId);
    }

    // Automated & Manual WhatsApp Reminders
    match /whatsapp_reminders/{reminderId} {
      allow read: if true;
      allow create, update: if isValidId(reminderId)
        && request.resource.data.id is string;
      allow delete: if isValidId(reminderId);
    }
  }
}
