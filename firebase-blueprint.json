{
  "entities": {
    "RoofReport": {
      "title": "RoofReport",
      "description": "Daily field report for roof assembly and tile installation (RDO de Cobertura)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dataPreenchimento": { "type": "string" },
        "responsavel": { "type": "string" },
        "predio": { "type": "string" },
        "qtdTranslúcidas": { "type": "number" },
        "qtdFibrocimento": { "type": "number" },
        "metragemCalhas": { "type": "number" },
        "condicoesClimaticas": { "type": "string" },
        "observacoes": { "type": "string" },
        "materiaisRecebidos": { "type": "string" },
        "criadoEm": { "type": "string" }
      },
      "required": ["id", "dataPreenchimento", "responsavel", "predio"]
    },
    "CalendarTask": {
      "title": "CalendarTask",
      "description": "Operational task or scheduled event on the turnkey site calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "responsible": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "predio": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "date", "status"]
    },
    "AIAction": {
      "title": "AIAction",
      "description": "AI action proposal generated by Assistente Samuel for developer approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "detectedIssue": { "type": "string" },
        "whatsappMessage": { "type": "string" },
        "createdAt": { "type": "string" },
        "approvedBy": { "type": "string" }
      },
      "required": ["id", "title", "status", "detectedIssue"]
    },
    "WhatsAppReminder": {
      "title": "WhatsAppReminder",
      "description": "Log of automated WhatsApp reminders and notifications dispatched by AI Agent Samuel (SVA Engenharia 08h30)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "date": { "type": "string" },
        "recipient": { "type": "string" },
        "targetPhone": { "type": "string" },
        "targetPhoneFormatted": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "dispatchedAt": { "type": "string" },
        "whatsappUrl": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "date", "recipient", "targetPhone", "status"]
    }
  },
  "firestore": {
    "/roof_reports/{reportId}": {
      "schema": "RoofReport",
      "description": "Collection of daily roof inspection and progress reports"
    },
    "/calendar_tasks/{taskId}": {
      "schema": "CalendarTask",
      "description": "Collection of operational site events and tasks"
    },
    "/ai_actions/{actionId}": {
      "schema": "AIAction",
      "description": "Collection of AI analysis actions and developer approval states"
    },
    "/whatsapp_reminders/{reminderId}": {
      "schema": "WhatsAppReminder",
      "description": "Collection of automated and manual WhatsApp reminder dispatches (08h30 SVA Engenharia)"
    }
  }
}
