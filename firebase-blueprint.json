{
  "entities": {
    "RoofReport": {
      "title": "RoofReport",
      "description": "Daily field report for roof assembly and tile installation (RDO de Cobertura)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dataPreenchimento": { "type": "string" },
        "responsavel": { "type": "string" },
        "predio": { "type": "string" },
        "qtdTranslúcidas": { "type": "number" },
        "qtdFibrocimento": { "type": "number" },
        "metragemCalhas": { "type": "number" },
        "metragemLinhaVida": { "type": "number" },
        "nivelChuvaMm": { "type": "number" },
        "chuvaMaior5mm": { "type": "boolean" },
        "ganhouDiaAdicional": { "type": "boolean" },
        "condicoesClimaticas": { "type": "string" },
        "periodosAfetadosClima": { "type": "string" },
        "observacoes": { "type": "string" },
        "materiaisRecebidos": { "type": "string" },
        "criadoEm": { "type": "string" }
      },
      "required": ["id", "dataPreenchimento", "responsavel", "predio"]
    },
    "CalendarTask": {
      "title": "CalendarTask",
      "description": "Operational task or scheduled event on the turnkey site calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "responsible": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "predio": { "type": "string" },
        "isRain": { "type": "boolean" },
        "rainVolumeMm": { "type": "number" },
        "rainPeriod": { "type": "string" },
        "paralyzedWork": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "date", "status"]
    },
    "WeatherAlert": {
      "title": "WeatherAlert",
      "description": "Meteorological risk assessment and rain stoppage alert generated by Gemini AI for Savoy Campinas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "riskLevel": { "type": "string" },
        "expectedRainMm": { "type": "number" },
        "probabilityPercent": { "type": "number" },
        "stoppageRisk": { "type": "boolean" },
        "grantContractDay": { "type": "boolean" },
        "safetyWarning": { "type": "string" },
        "technicalRecommendation": { "type": "string" },
        "generatedAt": { "type": "string" }
      },
      "required": ["id", "date", "riskLevel", "safetyWarning"]
    },
    "AIAction": {
      "title": "AIAction",
      "description": "AI action proposal generated by SANY Engineering AI for developer approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "detectedIssue": { "type": "string" },
        "whatsappMessage": { "type": "string" },
        "createdAt": { "type": "string" },
        "approvedBy": { "type": "string" }
      },
      "required": ["id", "title", "status", "detectedIssue"]
    },
    "WhatsAppReminder": {
      "title": "WhatsAppReminder",
      "description": "Log of automated WhatsApp reminders and notifications dispatched by SANY Engineering System (SVA Engenharia 08h30)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "date": { "type": "string" },
        "recipient": { "type": "string" },
        "targetPhone": { "type": "string" },
        "targetPhoneFormatted": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "dispatchedAt": { "type": "string" },
        "whatsappUrl": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "date", "recipient", "targetPhone", "status"]
    }
  },
  "firestore": {
    "/roof_reports/{reportId}": {
      "schema": "RoofReport",
      "description": "Collection of daily roof inspection and progress reports"
    },
    "/calendar_tasks/{taskId}": {
      "schema": "CalendarTask",
      "description": "Collection of operational site events and tasks"
    },
    "/weather_alerts/{alertId}": {
      "schema": "WeatherAlert",
      "description": "Collection of Gemini AI weather risk and rain stoppage alerts"
    },
    "/ai_actions/{actionId}": {
      "schema": "AIAction",
      "description": "Collection of AI analysis actions and contingency approvals"
    },
    "/whatsapp_reminders/{reminderId}": {
      "schema": "WhatsAppReminder",
      "description": "Collection of automated and manual WhatsApp reminder dispatches"
    }
  }
}
